# Copy this file to .env and replace every value. All values below are fictitious.
# .env is ignored by Git (see .gitignore). Never commit real credentials (AGENTS.md C2).

# PostgreSQL connection
MATRIZ_DB_URL=jdbc:postgresql://localhost:5432/matriz
MATRIZ_DB_USER=matriz
MATRIZ_DB_PASSWORD=change-me-local-db-password

# Password given to every demo account by the seed command. Stored only as a BCrypt hash.
MATRIZ_DEMO_PASSWORD=change-me-demo-password

# Optional: HTTP port (default 8080)
MATRIZ_PORT=8080
