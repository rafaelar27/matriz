# Copy this file to .env and replace every value. All values below are fictitious.
# .env is ignored by Git (see .gitignore). Never commit real credentials (AGENTS.md C2).

# PostgreSQL connection
MATRIZ_DB_URL=jdbc:postgresql://localhost:5432/matriz
MATRIZ_DB_USER=matriz
MATRIZ_DB_PASSWORD=change-me-local-db-password

# Database used by the automated tests that change data (mvn verify). Same role and password as above.
MATRIZ_TEST_DB_URL=jdbc:postgresql://localhost:5432/matriz_test

# Password given to every demo account by the seed command. Stored only as a BCrypt hash.
MATRIZ_DEMO_PASSWORD=change-me-demo-password

# Optional: HTTP port (default 8080)
MATRIZ_PORT=8080

# Optional: sign-in session idle timeout (default 8h). Examples: 8h, 30m, 1m.
MATRIZ_SESSION_TIMEOUT=8h

# Optional: send the session cookie only over HTTPS (default false for local HTTP use).
MATRIZ_COOKIE_SECURE=false

# Optional: base URL of the API for the user interface (default empty: the same server). Must be a path on the same
# site, such as /api behind a proxy; another site is not supported (same-site cookies, TD-03).
MATRIZ_API_BASE_URL=

# Optional: rate limits for sign-up and sign-in (NFR-11). Defaults shown.
#   MATRIZ_RATE_SIGN_UP_MAX=5   MATRIZ_RATE_SIGN_UP_WINDOW=1h
#   MATRIZ_RATE_SIGN_IN_MAX_PER_IP_AND_EMAIL=10   MATRIZ_RATE_SIGN_IN_MAX_PER_IP=50   MATRIZ_RATE_SIGN_IN_WINDOW=15m

# Hosted deployment (Render + Neon, docs/deployment.md): these are set ONLY in the Render dashboard, never in this file.
# Shape of the values, all fictitious:
#   MATRIZ_DB_URL=jdbc:postgresql://<neon-direct-host>/<database>?sslmode=verify-full&sslfactory=org.postgresql.ssl.DefaultJavaSSLFactory
#                  (direct endpoint, no "-pooler"; never sslmode=require, which skips the certificate check)
#   MATRIZ_DB_USER=<neon role>          MATRIZ_DB_PASSWORD=<neon role password>
#   MATRIZ_COOKIE_SECURE=true           PORT=10000 and MATRIZ_PORT=10000
#   SERVER_FORWARD_HEADERS_STRATEGY=native   (TD-13, pending; overrides the property in application.properties)

# Docker Compose (compose.yaml) reads this file too. Inside Compose the application connects to the "db" service by
# itself, so MATRIZ_DB_URL above is not used there; MATRIZ_DB_USER and MATRIZ_DB_PASSWORD become the database role
# of the PostgreSQL container, and MATRIZ_DEMO_PASSWORD is required by "docker compose run --rm seed".

# End-to-end test (e2e/, Playwright). Not read by the application. Set in the shell, not in .env.
#   E2E_USER_EMAIL=ana@example.com
#   E2E_USER_PASSWORD=<the MATRIZ_DEMO_PASSWORD given to the seed command>
#   E2E_BASE_URL=http://localhost:8080   (optional)
